{
  "mcpServers": {
    "polars-mcp": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "polars-mcp"
      ]
    },
    "sonarqube": {
      "command": "sonar",
      "args": [
        "run",
        "mcp",
        "--project",
        "OpenAfterHours_rwa_calculator"
      ]
    }
  }
}
