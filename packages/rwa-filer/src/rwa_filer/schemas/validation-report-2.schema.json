{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openafterhours.github.io/rwa_calculator/rwa-filer/schemas/validation-report-2.schema.json",
  "title": "rwa-filer validation report, version 2",
  "description": "One validated return: what it was computed from (identity), the verdict and whether the check was complete, the counts behind them, every finding, and every enforced rule's outcome, passes included. Within major version 2 the report only gains fields.",
  "type": "object",
  "required": [
    "schema",
    "generator",
    "identity",
    "header",
    "taxonomy",
    "status",
    "submittable",
    "completeness",
    "facts",
    "tables",
    "summary",
    "findings",
    "rules"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "rwa-filer/validation-report" },
        "version": { "type": "string", "pattern": "^2\\.[0-9]+$" }
      }
    },
    "generator": { "type": "string" },
    "identity": { "$ref": "#/$defs/identity" },
    "header": { "type": "object", "additionalProperties": { "type": "string" } },
    "taxonomy": {
      "type": "object",
      "required": ["module", "version", "entry_point"],
      "properties": {
        "module": { "type": "string" },
        "version": { "type": "string" },
        "entry_point": { "type": "string" },
        "status": {
          "description": "The module's status in this taxonomy release on run_date.",
          "enum": ["live", "future", "superseded"]
        },
        "applies_from": { "type": "string", "format": "date" },
        "applies_to": { "type": ["string", "null"], "format": "date" },
        "run_date": { "type": "string", "format": "date" },
        "chosen_by": {
          "description": "default: the release live for the module (or its only future one); version: named by the user; pack: a library caller passed the pack.",
          "enum": ["default", "version", "pack"]
        },
        "shipped": {
          "description": "Every shipped release with a pack for the module, newest first.",
          "type": "array",
          "items": { "type": "string" }
        },
        "covers_reference_date": {
          "description": "Whether the release's dates for the module cover the return's reference date; when not, the report carries STR011.",
          "type": "boolean"
        }
      }
    },
    "status": { "$ref": "#/$defs/status" },
    "submittable": { "type": "boolean" },
    "completeness": { "type": "array", "items": { "$ref": "#/$defs/cause" } },
    "facts": { "type": "integer", "minimum": 0 },
    "tables": { "type": "array", "items": { "type": "string" } },
    "summary": {
      "type": "object",
      "required": [
        "structure_findings",
        "rule_findings",
        "blocking_findings",
        "rules_enforced",
        "rules_executed",
        "rule_status",
        "not_evaluated_reasons",
        "templates_reported",
        "templates_uncovered",
        "templates_missing"
      ],
      "properties": {
        "release_findings": {
          "description": "Findings about the taxonomy release chosen (STR011): warnings, never blocking.",
          "type": "integer"
        },
        "structure_findings": { "type": "integer" },
        "rule_findings": { "type": "integer" },
        "blocking_findings": { "type": "integer" },
        "rule_book": { "type": ["string", "null"] },
        "rules_enforced": { "type": "integer" },
        "rules_executed": { "type": "integer" },
        "rule_status": { "type": "object", "additionalProperties": { "type": "integer" } },
        "not_evaluated_reasons": { "type": "object", "additionalProperties": { "type": "integer" } },
        "templates_reported": { "type": "array", "items": { "type": "string" } },
        "templates_uncovered": { "type": "array", "items": { "type": "string" } },
        "templates_missing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["template", "rules", "linked_from"],
            "properties": {
              "template": { "type": "string" },
              "rules": { "type": "array", "items": { "type": "string" } },
              "linked_from": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "deny_list": {
          "description": "Since 2.1. Null when no rule ran.",
          "oneOf": [{ "$ref": "#/$defs/deny_summary" }, { "type": "null" }]
        },
        "publisher_issues": {
          "description": "Since 2.1: each known issue with the published rules that labels a result, with the rules it labels and the breaks inside and outside its footprint. Labels never change the verdict.",
          "type": "array",
          "items": { "$ref": "#/$defs/issue_tally" }
        }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issue_note": {
      "description": "Since 2.1: a known issue with the published rule, labelling this result (rwa_filer.validate.issue_labels). breaks_inside / breaks_outside are null on a label that is not about a break.",
      "type": "object",
      "required": ["issue", "title", "kind", "status", "status_text", "effect", "attribution", "unsatisfied", "breaks_inside", "breaks_outside", "fixed_in", "sentence"],
      "properties": {
        "issue": { "type": "string", "pattern": "^PI-[0-9]{2}[a-z]?$" },
        "title": { "type": "string" },
        "kind": { "enum": ["defect", "clarification", "acknowledged"] },
        "status": { "enum": ["draft", "raised", "acknowledged", "fixed", "withdrawn"] },
        "status_text": { "type": "string" },
        "effect": { "enum": ["fails_correct_returns", "passes_wrong_returns", "never_runs"] },
        "attribution": { "enum": ["certain", "possible"] },
        "unsatisfied": { "type": "integer", "minimum": 0 },
        "breaks_inside": { "type": ["integer", "null"], "minimum": 0 },
        "breaks_outside": { "type": ["integer", "null"], "minimum": 0 },
        "fixed_in": { "type": ["string", "null"] },
        "sentence": { "type": "string" }
      }
    },
    "issue_tally": {
      "type": "object",
      "required": ["issue", "status", "effect", "rules", "breaks_inside", "breaks_outside"],
      "properties": {
        "issue": { "type": "string" },
        "status": { "type": "string" },
        "effect": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } },
        "breaks_inside": { "type": "integer", "minimum": 0 },
        "breaks_outside": { "type": "integer", "minimum": 0 }
      }
    },
    "issue_register": {
      "description": "Since 2.1: the publisher-issue register the labels came from. Outside evidence_id: labels are not checks.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["release", "file", "sha256", "issues"],
          "properties": {
            "release": { "type": "string" },
            "file": { "type": ["string", "null"] },
            "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "issues": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "deny_entry": {
      "description": "A Bank of England validations deny-list entry in force for the rule (since 2.1): the gateway no longer runs it (deactivated), or runs it as a warning (downgraded), from date_applied.",
      "type": "object",
      "required": ["rule_id", "module", "deny_type", "date_applied", "known_issue"],
      "properties": {
        "rule_id": { "type": "string" },
        "module": { "type": "string" },
        "deny_type": { "enum": ["deactivated", "downgraded"] },
        "date_applied": { "type": ["string", "null"], "format": "date" },
        "known_issue": { "type": ["integer", "null"] },
        "published_code": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "formula": {
      "description": "The published rule's own verdict, where the deny list changed the rule's outcome (since 2.1).",
      "type": "object",
      "required": ["severity", "status", "satisfied", "unsatisfied"],
      "properties": {
        "severity": { "enum": ["ERROR", "WARNING"] },
        "status": { "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
        "satisfied": { "type": "integer", "minimum": 0 },
        "unsatisfied": { "type": "integer", "minimum": 0 }
      }
    },
    "deny_summary": {
      "description": "What the release's validations deny list did for the module on the date it was applied for (since 2.1).",
      "type": "object",
      "required": ["release", "file", "sha256", "applied_on", "deactivated", "downgraded", "not_applied"],
      "properties": {
        "release": { "type": "string" },
        "file": { "type": ["string", "null"] },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "applied_on": { "type": "string", "format": "date" },
        "deactivated": { "type": "array", "items": { "type": "string" } },
        "downgraded": { "type": "array", "items": { "type": "string" } },
        "not_applied": { "type": "array", "items": { "$ref": "#/$defs/deny_entry" } }
      }
    },
    "status": { "enum": ["CLEAN", "INCOMPLETE", "BLOCKED"] },
    "identity": {
      "type": "object",
      "required": ["evidence_id", "generator", "input", "taxonomy", "rulebook", "settings"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/sha256" },
        "generator": {
          "type": "object",
          "required": ["package", "version"],
          "properties": { "package": { "const": "rwa-filer" }, "version": { "type": "string" } }
        },
        "input": {
          "type": "object",
          "required": ["file", "format", "file_sha256", "facts_sha256", "facts", "header"],
          "properties": {
            "file": { "type": ["string", "null"] },
            "format": { "type": ["string", "null"] },
            "file_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "facts_sha256": { "$ref": "#/$defs/sha256" },
            "facts": { "type": "integer", "minimum": 0 },
            "header": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "taxonomy": {
          "type": "object",
          "required": ["module", "version", "pack", "entry_point", "sha256"],
          "properties": {
            "module": { "type": "string" },
            "version": { "type": "string" },
            "pack": { "type": "string" },
            "entry_point": { "type": "string" },
            "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
          }
        },
        "rulebook": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": [
                "file",
                "framework_version",
                "taxonomy",
                "sha256",
                "workbook_sha256",
                "formulas_package_sha256",
                "rules_loaded",
                "rules_enforced"
              ],
              "properties": {
                "file": { "type": ["string", "null"] },
                "framework_version": { "type": "string" },
                "taxonomy": { "type": "string" },
                "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
                "workbook_sha256": { "type": ["string", "null"] },
                "formulas_package_sha256": { "type": ["string", "null"] },
                "rules_loaded": { "type": "integer" },
                "rules_enforced": { "type": "integer" }
              }
            }
          ]
        },
        "settings": {
          "type": "object",
          "required": ["accuracy"],
          "properties": {
            "accuracy": {
              "type": "object",
              "required": ["monetary_decimals", "percentage_decimals", "source"],
              "properties": {
                "monetary_decimals": { "type": "integer" },
                "percentage_decimals": { "type": "integer" },
                "source": { "enum": ["default", "given"] }
              }
            }
          }
        },
        "deny_list": {
          "description": "Since 2.1: the validations deny list applied. evidence_id covers in_force, not the file or the date.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["release", "file", "sha256", "applied_on", "in_force"],
              "properties": {
                "release": { "type": "string" },
                "file": { "type": ["string", "null"] },
                "sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
                "applied_on": { "type": "string", "format": "date" },
                "in_force": { "type": "array", "items": { "$ref": "#/$defs/deny_entry" } }
              }
            }
          ]
        },
        "publisher_issues": { "$ref": "#/$defs/issue_register" }
      }
    },
    "cause": {
      "type": "object",
      "required": ["code", "rules", "templates", "detail"],
      "properties": {
        "code": {
          "enum": [
            "no_rulebook",
            "rules_unsupported",
            "rules_table_not_in_taxonomy",
            "linked_templates_missing",
            "coverage_shortfall"
          ]
        },
        "rules": { "type": "array", "items": { "type": "string" } },
        "templates": { "type": "array", "items": { "type": "string" } },
        "detail": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "blocking",
        "subject",
        "message",
        "expected",
        "actual",
        "reference",
        "positions_total"
      ],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["ERROR", "WARNING"] },
        "blocking": { "type": "boolean" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "reference": { "type": "string" },
        "positions_total": { "type": "integer", "minimum": 0 },
        "publisher_issues": {
          "description": "Since 2.1: the ids of the known issues with the published rule that label a broken rule's finding; the message carries their sentences.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "address": {
      "type": "object",
      "required": ["table", "sheet", "open_key", "row", "column"],
      "properties": {
        "table": { "type": "string" },
        "sheet": { "type": ["string", "null"] },
        "open_key": { "type": ["string", "null"] },
        "row": { "type": "string" },
        "column": { "type": "string" },
        "reported": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "rule_id",
        "rule_sha256",
        "severity",
        "status",
        "reason",
        "detail",
        "evaluations",
        "satisfied",
        "unsatisfied",
        "tables",
        "failures"
      ],
      "properties": {
        "rule_id": { "type": "string" },
        "rule_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "severity": { "enum": ["ERROR", "WARNING"] },
        "status": { "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
        "reason": { "type": "string" },
        "detail": { "type": "string" },
        "evaluations": { "type": "integer", "minimum": 0 },
        "satisfied": { "type": "integer", "minimum": 0 },
        "unsatisfied": { "type": "integer", "minimum": 0 },
        "tables": { "type": "array", "items": { "type": "string" } },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["place", "cells", "addresses"],
            "properties": {
              "place": { "type": "string" },
              "cells": { "type": "array", "items": { "type": "string" } },
              "addresses": { "type": "array", "items": { "$ref": "#/$defs/address" } }
            }
          }
        },
        "deny_list": {
          "description": "Since 2.1: the deny-list entry in force for the rule, or null.",
          "oneOf": [{ "$ref": "#/$defs/deny_entry" }, { "type": "null" }]
        },
        "formula": {
          "description": "Since 2.1: the published rule's verdict where the deny list changed it, or null.",
          "oneOf": [{ "$ref": "#/$defs/formula" }, { "type": "null" }]
        },
        "publisher_issues": {
          "description": "Since 2.1: the known issues with the published rule that label this result.",
          "type": "array",
          "items": { "$ref": "#/$defs/issue_note" }
        }
      }
    }
  }
}
